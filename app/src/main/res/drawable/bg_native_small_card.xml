<?xml version="1.0" encoding="utf-8"?>
<!-- Small native card: white with a 1px gold-cream border, radius 16. White reads on both the
     cream screens (Sankalp, Set Reminder) and the kumkum red ones (Jap, Voice Jap). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFFFFF" />
    <stroke
        android:width="1dp"
        android:color="#F0DDBE" />
    <corners android:radius="16dp" />
</shape>
