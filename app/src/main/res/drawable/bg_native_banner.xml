<?xml version="1.0" encoding="utf-8"?>
<!-- Native "banner" bar: cream, a 1dp gold line along the top edge, flush to the screen sides -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#B3FFD682" />
        </shape>
    </item>
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFF8EC" />
        </shape>
    </item>
</layer-list>
