<?xml version="1.0" encoding="utf-8"?>
<!-- Native ad that looks like a banner: one 90dp row, icon + headline / "Ad" badge + body, CTA pill.
     No MediaView (like Google's small template) and deliberately no ad_container / block_icon_headline
     ids: populateNativeAdView would reorder those into a vertical stack. With neither id it just
     shows or hides the individual views from the config's "components" (icon_headline, body, cta). -->
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:ignore="HardcodedText,SpUsage">

    <LinearLayout
        android:id="@+id/ad_banner_row"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="@drawable/bg_native_banner"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="1dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/ad_app_icon"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:background="@drawable/bg_ad_app_icon_kumkum"
            android:clipToOutline="true"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView android:textStyle="bold"
                android:id="@+id/ad_headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#3B2414"
                android:textSize="17sp"
                tools:text="Advertiser headline" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView android:textStyle="bold"
                    android:id="@+id/ad_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_ad_icon_kumkum"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="2dp"
                    android:text="Ad"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/ad_body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#8A6A4C"
                    android:textSize="14sp"
                    tools:text="Short description of the offer" />

                <!-- Hidden placeholder the SDK fills when there is no body text -->
                <TextView
                    android:id="@+id/ad_advertiser"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton android:textStyle="bold"
            android:id="@+id/ad_call_to_action"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_native_banner_cta"
            android:includeFontPadding="false"
            android:maxWidth="150dp"
            android:minWidth="104dp"
            android:minHeight="0dp"
            android:paddingHorizontal="18dp"
            android:singleLine="true"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="#FFF1DC"
            android:textSize="16sp"
            tools:text="Install" />
    </LinearLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
