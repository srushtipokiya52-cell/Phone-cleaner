<?xml version="1.0" encoding="utf-8"?>
<!-- Fullscreen native between intro pages 2 and 3: shimmer until the ad renders, close button only once it has. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg_warm">

    <include
        layout="@layout/layout_shimmer_native_full"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/adHolder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/btnClose"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="end|top"
        android:layout_margin="12dp"
        android:background="@drawable/bg_circle"
        android:contentDescription="Close"
        android:padding="12dp"
        android:src="@drawable/ic_close"
        android:visibility="gone" />
</FrameLayout>
