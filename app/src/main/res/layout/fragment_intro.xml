<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_intro_top1">

        <TextView
            android:id="@+id/skip"
            style="@style/Btn.Text"
            android:layout_gravity="end|top"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            android:text="@string/tr_Skip"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/art"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-32dp"
        android:background="@drawable/bg_sheet"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="32dp"
        android:paddingEnd="28dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/introTitle"
            style="@style/Txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.1"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/introBody"
            style="@style/Txt.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minLines="4"
            android:textSize="15sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:id="@+id/dots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|start"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

            <ImageView
                android:id="@+id/btnNext"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="end"
                android:background="@drawable/bg_btn_round"
                android:contentDescription="Next"
                android:padding="18dp"
                android:src="@drawable/ic_arrow_right"
                android:tint="@color/white" />

            <TextView
                android:id="@+id/btnStart"
                style="@style/Btn.Primary"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:layout_gravity="end"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:text="@string/tr_Get_Started"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
