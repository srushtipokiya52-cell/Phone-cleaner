<?xml version="1.0" encoding="utf-8"?>
<!-- Loading placeholder matching layout_native_onboarding_kumkum -->
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmer_native_medium"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:shimmer_auto_start="true"
    app:shimmer_base_alpha="0.8"
    app:shimmer_direction="left_to_right"
    app:shimmer_duration="1200"
    app:shimmer_highlight_alpha="0.3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_ad_app_icon_kumkum" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <View
                    android:layout_width="120dp"
                    android:layout_height="13dp"
                    android:background="@drawable/bg_ad_icon_kumkum"
                    android:backgroundTint="#E9DFCF" />

                <View
                    android:layout_width="70dp"
                    android:layout_height="11dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_ad_icon_kumkum"
                    android:backgroundTint="#E9DFCF" />
            </LinearLayout>

            <View
                android:layout_width="24dp"
                android:layout_height="18dp"
                android:background="@drawable/bg_ad_icon_kumkum"
                android:backgroundTint="#E9DFCF" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ad_media_kumkum" />

        <View
            android:layout_width="200dp"
            android:layout_height="12dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_ad_icon_kumkum"
            android:backgroundTint="#E9DFCF" />

        <View
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_ad_cta_kumkum"
            android:backgroundTint="#E9DFCF" />
    </LinearLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
