<?xml version="1.0" encoding="utf-8"?>
<!-- "Loading ad..." shown while a rewarded ad loads: scrim, a small cream card with a kumkum spinner -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#9E1E0606"
    android:clickable="true"
    android:focusable="false">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_reward_card"
        android:elevation="16dp"
        android:gravity="center_horizontal"
        android:minWidth="190dp"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="24dp"
        android:paddingEnd="28dp"
        android:paddingBottom="22dp">

        <ProgressBar
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:indeterminate="true"
            android:indeterminateTint="#B01F1F" />

        <TextView android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:includeFontPadding="false"
            android:text="@string/reward_loading"
            android:textColor="#3B2414"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/reward_loading_hi"
            android:textColor="#B8741E"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
