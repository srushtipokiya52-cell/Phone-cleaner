<?xml version="1.0" encoding="utf-8"?>
<!-- Loading placeholder matching layout_native_banner -->
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmer_native_banner"
    android:layout_width="match_parent"
    android:layout_height="90dp"
    android:background="@drawable/bg_native_banner"
    app:shimmer_auto_start="true"
    app:shimmer_base_alpha="0.8"
    app:shimmer_direction="left_to_right"
    app:shimmer_duration="1200"
    app:shimmer_highlight_alpha="0.3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="1dp"
        android:paddingEnd="16dp">

        <View
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:background="@drawable/bg_ad_app_icon_kumkum" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <View
                android:layout_width="200dp"
                android:layout_height="16dp"
                android:background="@drawable/bg_ad_icon_kumkum"
                android:backgroundTint="#E9DFCF" />

            <View
                android:layout_width="140dp"
                android:layout_height="13dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_ad_icon_kumkum"
                android:backgroundTint="#E9DFCF" />
        </LinearLayout>

        <View
            android:layout_width="116dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_ad_cta_kumkum"
            android:backgroundTint="#E9DFCF" />
    </LinearLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
