<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_intro_top1">

        <ImageView
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/art_permission" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-32dp"
        android:background="@drawable/bg_sheet"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="28dp"
        android:paddingEnd="28dp"
        android:paddingBottom="16dp">

        <TextView
            style="@style/Txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tr_Allow_file_access"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            style="@style/Txt.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/tr_Phone_Cleaner_needs_access_to_your_files_to_find_junk_and_free_u"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/bullets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/btnContinue"
            style="@style/Btn.Primary"
            android:layout_marginTop="16dp"
            android:text="@string/tr_Allow" />

        <TextView
            android:id="@+id/btnLater"
            style="@style/Btn.Text"
            android:layout_width="match_parent"
            android:text="@string/tr_Maybe_later"
            android:textColor="@color/muted" />
    </LinearLayout>
</LinearLayout>
